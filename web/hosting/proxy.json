{
  "proxies": {
    "/api/llm": {
      "upstream": "https://api.deepseek.com/chat/completions",
      "method": "POST",
      "headers": {
        "Authorization": "Bearer ${LLM_API_KEY}"
      },
      "rateLimit": "240/hour/ip"
    }
  },
  "rewrites": [
    { "source": "/cases/:caseId", "destination": "/cases/open" },
    { "source": "/cases/:caseId/:page", "destination": "/cases/open" },
    { "source": "/cases/:caseId/:page/:rest", "destination": "/cases/open" }
  ]
}
