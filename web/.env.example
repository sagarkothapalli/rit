# Email delivery. Without one of these no code can reach an inbox: Firebase Auth
# only emails sign-in links, never a six digit code. Sign up at resend.com,
# verify a sending domain, then set both.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM="Praja RTI <verify@yourdomain.in>"

# Demo bypass. Unset or 1: 0000 and 000000 always verify and the issued code is
# shown in the UI when no provider is configured. Set to 0 for real verification.
PRAJA_OTP_BYPASS=1
