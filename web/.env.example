# Gemini key for the live intake and drafting gates. Without it the app runs
# on its deterministic fallbacks.
LLM_API_KEY=

# Admin console PIN. Give it enough digits that 60 guesses per 15 minutes —
# what the login limiter allows deployment-wide — is hopeless. 8+ digits.
ADMIN_PIN=

# Signs the admin session cookie. Set this in production: without it the cookie
# is signed with ADMIN_PIN, so anyone holding a cookie can brute-force the PIN
# back out of it offline. Any long random string; changing it logs admins out,
# which is also how you revoke a leaked cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Deployment-wide ceiling on model calls per hour. The /api/agent/* and
# /api/live/token routes are unauthenticated by design (citizens have no
# account), so this is what stops a distributed caller draining LLM_API_KEY.
LLM_GLOBAL_HOURLY_LIMIT=600
