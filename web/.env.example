# Server-only secrets. Do not prefix with NEXT_PUBLIC_.
# Copy to .env.local for local development. Never commit real values.

LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_FAST=deepseek-v4-flash
LLM_MODEL_STRONG=deepseek-v4-flash
LLM_API_KEY=
# Gemini alternative:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL_FAST=gemini-3.7-flash
# LLM_MODEL_STRONG=gemini-3.7-flash
ADMIN_PIN=
DATABASE_URL=

# Gemini Live voice intake (optional overrides).
# Token minting uses the admin-panel runtime key by default, then LLM_API_KEY.
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# GEMINI_LIVE_API_KEY=
# GEMINI_LIVE_ENABLED=false   # set to false to force the language-chip flow
# NEXT_PUBLIC_GEMINI_LIVE_VOICE=Kore
